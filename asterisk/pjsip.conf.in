[transport-udp]
type=transport
protocol=udp
bind={SIP_BIND}:5060
{NAT_LINES}
[{SIP_USER}]
type=endpoint
transport=transport-udp
context=from-phone
disallow=all
allow=ulaw,alaw
auth={SIP_USER}-auth
aors={SIP_USER}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
callerid="Claude" <claude>

[{SIP_USER}-auth]
type=auth
auth_type=userpass
username={SIP_USER}
password={SIP_PASSWORD}

[{SIP_USER}]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30
default_expiration=120
maximum_expiration=120
minimum_expiration=60
