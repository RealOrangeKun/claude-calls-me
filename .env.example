# Copied to .env by install.sh, which fills in random passwords and your Tailscale IP.
# After editing, re-run ./install.sh (or asterisk/run.sh) so Asterisk picks it up.

# SIP account the phone's Linphone logs into
SIP_USER=phone
SIP_PASSWORD=change-me

# Asterisk manager login voiced.py uses to place outgoing calls (localhost only)
AMI_USER=claude
AMI_PASSWORD=change-me

# This computer's Tailscale IPv4 (`tailscale ip -4`); SIP listens only here
TAILSCALE_IP=100.x.y.z

# Optional: host (Linux default) or bridge (macOS default; Docker Desktop has no host networking)
#CALLME_DOCKER_NET=
